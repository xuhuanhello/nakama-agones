# Supported GameFleet adapter. This selects the independent gfsvc service identity.
NAKAMA_FLEET_BACKEND=gamefleet-service

# Use verified private HTTPS reachability where available; otherwise a dedicated
# public mTLS business endpoint. Never use the admin/upload/Kubernetes endpoint.
GAMEFLEET_SERVICE_URL=https://business.example.com
GAMEFLEET_SERVICE_CA_FILE=/run/secrets/gamefleet-ca.crt
GAMEFLEET_SERVICE_CERT_FILE=/run/secrets/gamefleet-client.crt
GAMEFLEET_SERVICE_TLS_KEY_FILE=/run/secrets/gamefleet-client.key

# Mount the owner-issued gfsvc_ key as a private regular file (0400 or 0600).
# Never put the key value in this file, an environment variable, or a log.
GAMEFLEET_SERVICE_KEY_FILE=/run/secrets/gamefleet-service-key

# Replace these with the exact identity/profile values from the GameFleet
# service and selected player profile. These placeholders are not credentials.
GAMEFLEET_SERVICE_ID=service_replace_me
GAMEFLEET_SERVICE_APPLICATION_ID=application_replace_me
GAMEFLEET_SERVICE_IDENTITY_ISSUER=issuer_replace_me
GAMEFLEET_SERVICE_REGION=region_replace_me
GAMEFLEET_SERVICE_COMPATIBILITY=compatibility_replace_me

# Optional terminal-only archive reader. Leave all seven settings unset or
# empty to disable it. If enabled, use its own owner-issued gfsvc_ key and
# exact historical scope; see docs/gamefleet-service-runtime.md.
GAMEFLEET_ARCHIVE_URL=
GAMEFLEET_ARCHIVE_KEY_FILE=
GAMEFLEET_ARCHIVE_APPLICATION_ID=
GAMEFLEET_ARCHIVE_IDENTITY_ISSUER=
GAMEFLEET_ARCHIVE_REGION=
GAMEFLEET_ARCHIVE_COMPATIBILITY=
GAMEFLEET_ARCHIVE_SERVICE_ID=
GAMEFLEET_ARCHIVE_CA_FILE=
GAMEFLEET_ARCHIVE_CERT_FILE=
GAMEFLEET_ARCHIVE_TLS_KEY_FILE=
