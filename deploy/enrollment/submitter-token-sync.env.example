# Copy the existing token-sync service/timer under a distinct enrollment name.
# Change its User to fleet-console, --output-dir AND ReadWritePaths to
# /var/lib/fleet-console/enrollment-credentials. Do not reuse runtime/observer files.
SSH_HOST=manager.example.internal
SSH_USER=root
SSH_PORT=22
SSH_KEY_FILE=/var/lib/fleet-console/enrollment-sync/token-pull.key
SSH_KNOWN_HOSTS=/var/lib/fleet-console/enrollment-sync/known_hosts
EXPECTED_API_URL=https://manager.example.internal:6443
EXPECTED_NAMESPACE=fleet-enrollment-system
EXPECTED_SERVICE_ACCOUNT=fleet-enrollment-submitter
