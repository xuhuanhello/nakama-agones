# Documentation template only. Supply real values through your secret manager.
# Never commit a filled copy. A changed persistent profile requires a new deployment ID.
AGONES_FLEET_DEPLOYMENT_ID=region-a-pool-v1
AGONES_FLEET_MODE=production
AGONES_FLEET_DATABASE_URL=postgres://fleet:CHANGE_ME@private-db:5432/agones_fleet?sslmode=verify-full
AGONES_FLEET_CONTROL_URL=https://nakama.example.com
AGONES_FLEET_BUILD_HASH=game-v1
AGONES_FLEET_REGION=region-a
AGONES_FLEET_MAX_ROOMS=4
# Keep one ready game process on always-on hosts; use 0 only for intentional scale-to-zero.
AGONES_FLEET_MIN_INSTANCES=1
AGONES_FLEET_MAX_INSTANCES=4
AGONES_FLEET_IDLE_SECONDS=300
AGONES_FLEET_LAUNCH_TIMEOUT=180
AGONES_FLEET_ALLOCATION_TIMEOUT=240
AGONES_FLEET_ADMIN_TOKEN=CHANGE_ME_RANDOM_AT_LEAST_32_CHARACTERS
AGONES_FLEET_SIGNING_KEY=CHANGE_ME_BASE64URL_32_RANDOM_BYTES
AGONES_FLEET_SERVER_ENV_JSON={}
AGONES_NAMESPACE=agones-games
AGONES_POOL=region-a
AGONES_GAME_IMAGE=ghcr.io/your-org/your-game@sha256:REPLACE_WITH_DIGEST
AGONES_GAME_PORT=7770
AGONES_CPU_REQUEST=1000m
AGONES_CPU_LIMIT=
AGONES_MEMORY_REQUEST=512Mi
AGONES_MEMORY_LIMIT=2Gi
AGONES_NODE_SELECTOR_JSON={"kubernetes.io/arch":"amd64","nakama-agones.io/game-node":"true"}
# In-cluster credentials default to the projected service-account token and CA.
# For an external Nakama, override these with private endpoint + rotated token file.
AGONES_KUBERNETES_API_URL=https://kubernetes.default.svc
AGONES_KUBERNETES_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
AGONES_KUBERNETES_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
# Optional existing registry pull secret in AGONES_NAMESPACE.
AGONES_IMAGE_PULL_SECRET=
