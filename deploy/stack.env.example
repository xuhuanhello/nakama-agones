# The infrastructure image digests below are checked-in, immutable references.
# Update them only by resolving and reviewing the repository digest for a chosen release.
# Runtime image comes from Fixed's complete application image build. Use either
# its exact local sha256 image ID or a pulled repository@sha256 digest. It must
# contain agones.so and every module listed in APPLICATION_REQUIRED_MODULES.
# This template contains no passwords or keys.
NAKAMA_DOMAIN=game.example.com
NAKAMA_RUNTIME_IMAGE=sha256:replace_with_the_exact_Fixed_local_image_ID
# Set to account.so for the Fixed build; leave empty for applications with no extra module.
APPLICATION_REQUIRED_MODULES=
POSTGRES_IMAGE=docker.io/library/postgres@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea
CADDY_IMAGE=docker.io/library/caddy@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648


# Keep these ranges unused by other Docker networks on this host.
FRONTEND_SUBNET=172.29.240.0/24
DATABASE_SUBNET=172.29.241.0/24
CADDY_IPV4=172.29.240.2
NAKAMA_IPV4=172.29.240.3

# Secret source paths. Files are created locally by `nakama_stack.py init`
# except the owner-provided GameFleet service key and TLS files.
POSTGRES_PASSWORD_SOURCE=./private/postgres-password
NAKAMA_SOCKET_SERVER_KEY_SOURCE=./private/nakama-socket-server-key
NAKAMA_SESSION_KEY_SOURCE=./private/nakama-session-encryption-key
NAKAMA_REFRESH_KEY_SOURCE=./private/nakama-refresh-encryption-key
NAKAMA_RUNTIME_HTTP_KEY_SOURCE=./private/nakama-runtime-http-key
NAKAMA_CONSOLE_PASSWORD_SOURCE=./private/nakama-console-password
NAKAMA_CONSOLE_SIGNING_KEY_SOURCE=./private/nakama-console-signing-key
GAMEFLEET_SERVICE_ENV_FILE=./private/gamefleet-service.env
GAMEFLEET_SERVICE_KEY_SOURCE=./private/gamefleet-service-key
GAMEFLEET_ARCHIVE_KEY_SOURCE=./private/gamefleet-archive-key.disabled
GAMEFLEET_ARCHIVE_KEY_TARGET=
APPLICATION_ENV_FILE=./private/account.env
APPLICATION_SECRET_FILE=./private/application-credentials.json
APPLICATION_SECRET_TARGET=account_credentials
GAMEFLEET_CA_SOURCE=./private/gamefleet-ca.crt
GAMEFLEET_CERT_SOURCE=./private/gamefleet-client.crt
GAMEFLEET_TLS_KEY_SOURCE=./private/gamefleet-client.key
GAMEFLEET_ARCHIVE_CA_SOURCE=./private/gamefleet-archive-ca.disabled
GAMEFLEET_ARCHIVE_CERT_SOURCE=./private/gamefleet-archive-cert.disabled
GAMEFLEET_ARCHIVE_TLS_KEY_SOURCE=./private/gamefleet-archive-tls-key.disabled
# Optional container-local business DNS pin. Use nakama_stack.py route to set both.
# Empty values use normal container DNS; TLS always verifies the URL hostname.
GAMEFLEET_SERVICE_HOST=
GAMEFLEET_SERVICE_HOST_IP=
