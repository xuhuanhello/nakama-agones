# Explicit opt-in. If omitted or set to "agones", the existing Agones backend remains active.
NAKAMA_FLEET_BACKEND=gamefleet

# Dedicated HTTPS business endpoint with mutual TLS.
# For an SSH local forward, make the listener reachable inside that namespace.
GAMEFLEET_BUSINESS_URL=https://business.example.com:17682
GAMEFLEET_BUSINESS_CA_FILE=/run/secrets/gamefleet-ca.crt
GAMEFLEET_BUSINESS_CERT_FILE=/run/secrets/gamefleet-client.crt
GAMEFLEET_BUSINESS_TLS_KEY_FILE=/run/secrets/gamefleet-client.key

# Mount the GameFleet Business key as a private regular file (chmod 0600 or 0400).
# The key value belongs in the file, never in this environment file.
GAMEFLEET_BUSINESS_KEY_FILE=/run/secrets/gamefleet-business-key

# Expected immutable machine scope. Replace all placeholders with exact configured values.
GAMEFLEET_APPLICATION_ID=application_replace_me
GAMEFLEET_PLACEMENT_ID=placement_replace_me
GAMEFLEET_REVISION_ID=revision_replace_me
GAMEFLEET_REGION=pilot_region_replace_me
GAMEFLEET_COMPATIBILITY=pilot_build_replace_me

# Optional terminal-only history reader. Leave ALL seven blank to disable it.
# This is an independent gfsvc credential, never the active gfbiz key above.
# Create a read-only history service in GameFleet, then explicitly grant each
# retained caller + participant to archive-routes. Old caller stays revoked.
# The HTTPS preflight pins service ID, application and issuer before hooks load.
GAMEFLEET_ARCHIVE_URL=
GAMEFLEET_ARCHIVE_KEY_FILE=
GAMEFLEET_ARCHIVE_APPLICATION_ID=
GAMEFLEET_ARCHIVE_IDENTITY_ISSUER=
GAMEFLEET_ARCHIVE_REGION=
GAMEFLEET_ARCHIVE_COMPATIBILITY=
GAMEFLEET_ARCHIVE_SERVICE_ID=
# Example after an owner grant (replace identifiers with the actual old scope):
# GAMEFLEET_ARCHIVE_URL=https://archive-business.example.com:17682
# GAMEFLEET_ARCHIVE_KEY_FILE=/run/secrets/gamefleet-archive-key
# GAMEFLEET_ARCHIVE_APPLICATION_ID=application_old_source
# GAMEFLEET_ARCHIVE_IDENTITY_ISSUER=nakama_pilot
# GAMEFLEET_ARCHIVE_REGION=us-west
# GAMEFLEET_ARCHIVE_COMPATIBILITY=dm-v1
# GAMEFLEET_ARCHIVE_SERVICE_ID=history_service_replace_me
