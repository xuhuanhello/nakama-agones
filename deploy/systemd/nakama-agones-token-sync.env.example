# Non-secret receiver configuration. Replace example host names before use.
SSH_HOST=manager.example.internal
SSH_USER=root
SSH_PORT=22
SSH_KEY_FILE=/opt/nakama-agones/credential-sync/token-pull.key
SSH_KNOWN_HOSTS=/opt/nakama-agones/credential-sync/known_hosts
EXPECTED_API_URL=https://kubernetes.example.internal:6443
EXPECTED_NAMESPACE=agones-control
EXPECTED_SERVICE_ACCOUNT=nakama-agones
